# بدون هبد! backend configuration — copy to .env and fill in.
#   copy .env.example .env
# Every key is optional; each feature degrades gracefully when its key is
# missing (the server always boots).

# --- Smart Judge (offline mode: POST /verify-fact) -------------------------
# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# --- Online-mode AI judge (WebSocket rooms) --------------------------------
# OpenAI-compatible chat-completions API. Leave LLM_API_KEY empty to reuse
# GROQ_API_KEY (the zero-config default). Works with Groq, OpenRouter,
# OpenAI, or Gemini's OpenAI-compatible endpoint — just point the base URL.
LLM_API_KEY=
LLM_MODEL_NAME=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- Google Sign-In --------------------------------------------------------
# The WEB application OAuth client ID (also baked into the Flutter app as
# GOOGLE_SERVER_CLIENT_ID). NOT the Android client.
GOOGLE_CLIENT_ID=
# Long random string signing our app JWTs. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- Abuse protection ------------------------------------------------------
# Shared secret the app sends as X-App-Token (bake the same value into the
# app build with --dart-define=APP_TOKEN=...). Empty = enforcement off.
APP_TOKEN=

# --- Admin API (/api/admin in /docs) ---------------------------------------
# Long random string sent as the X-Admin-Token header. Empty = admin API off.
ADMIN_TOKEN=

# --- Database --------------------------------------------------------------
# Empty = local SQLite (players.db). Production: a hosted Postgres URL
# (Neon/Supabase); postgres:// prefixes are normalized automatically.
DATABASE_URL=

# --- Multiplayer dev toggles ----------------------------------------------
# Minimum players to start an online match. Production default is 2;
# set to 1 ONLY for solo testing of the full game loop.
#MIN_PLAYERS_TO_START=1
